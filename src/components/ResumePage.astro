---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Section from './Section.astro';
import type { Lang } from '../utils';
import { data, asset } from '../utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = data[lang];
const period = (s: string, e: string) => (s === e ? s : `${s} – ${e || d.ui.present}`);

const c = d.contact;
const contacts = [
  c.email && { label: 'Email', value: c.email, href: `mailto:${c.email}`, icon: 'M4 6h16v12H4z M4 6l8 7 8-7' },
  c.phone && { label: lang === 'th' ? 'โทรศัพท์' : 'Phone', value: c.phone, href: `tel:${c.phone.replace(/[^+\d]/g, '')}`, icon: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2' },
  c.linkedin && { label: 'LinkedIn', value: c.linkedin.replace(/^https?:\/\/(www\.)?/, ''), href: c.linkedin, icon: 'M4 9h4v11H4z M6 4a2 2 0 1 1 0 4 2 2 0 0 1 0-4 M10 9h4v2a4 4 0 0 1 7 3v6h-4v-6a2 2 0 0 0-4 0v6h-3z' },
  c.github && { label: 'GitHub', value: c.github.replace(/^https?:\/\//, ''), href: c.github, icon: 'M9 19c-4 1.5-4-2-6-2.5m12 5v-3.5a3 3 0 0 0-1-2.5c3 0 6-2 6-5.5a4.5 4.5 0 0 0-1.3-3.2 4 4 0 0 0-.1-3.2s-1-.3-3.3 1.2a11.5 11.5 0 0 0-6 0C7 2.3 6 2.6 6 2.6a4 4 0 0 0-.1 3.2A4.5 4.5 0 0 0 4.6 9c0 3.5 3 5.5 6 5.5a3 3 0 0 0-1 2.5V22' },
  c.website && { label: 'Website', value: c.website.replace(/^https?:\/\//, ''), href: c.website, icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18 M3 12h18 M12 3c3 3 3 15 0 18 M12 3c-3 3-3 15 0 18' },
].filter(Boolean) as { label: string; value: string; href: string; icon: string }[];

const card = 'rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900';
---
<Base lang={lang} title={`${d.profile.name} — ${d.profile.title}`} description={d.profile.summary}>
  <Header lang={lang} />
  <main>
    <Hero lang={lang} />

    <Section id="about" title={d.ui.nav.about}>
      <div class="max-w-3xl space-y-4 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        {d.about.map((para) => <p>{para}</p>)}
      </div>
    </Section>

    {d.experience.length > 0 && (
      <Section id="experience" title={d.ui.nav.experience}>
        <ol class="relative space-y-8 border-l-2 border-slate-200 pl-6 dark:border-slate-800">
          {d.experience.map((x) => (
            <li class="relative">
              <span class="absolute -left-[33px] top-1.5 h-4 w-4 rounded-full border-4 border-white bg-brand-500 dark:border-slate-950"></span>
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{x.role}</h3>
                <span class="text-sm text-slate-500 dark:text-slate-400">{period(x.start, x.end)}</span>
              </div>
              <p class="font-medium text-brand-600 dark:text-brand-400">{x.company}</p>
              <ul class="mt-2 list-disc space-y-1 pl-5 text-slate-600 dark:text-slate-300">
                {x.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </Section>
    )}

    {d.education.length > 0 && (
      <Section id="education" title={d.ui.nav.education}>
        <div class="grid gap-4 md:grid-cols-2">
          {d.education.map((e) => (
            <div class={card}>
              <p class="text-sm text-slate-500 dark:text-slate-400">{period(e.start, e.end)}</p>
              <h3 class="mt-1 font-semibold text-slate-900 dark:text-white">{e.degree}</h3>
              <p class="text-brand-600 dark:text-brand-400">{e.school}</p>
              {e.detail && <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{e.detail}</p>}
            </div>
          ))}
        </div>
      </Section>
    )}

    {d.skills.length > 0 && (
      <Section id="skills" title={d.ui.nav.skills}>
        <div class="grid gap-4 md:grid-cols-3">
          {d.skills.map((g) => (
            <div class={card}>
              <h3 class="mb-3 font-semibold text-slate-900 dark:text-white">{g.group}</h3>
              <div class="flex flex-wrap gap-2">
                {g.items.map((s) => (
                  <span class="rounded-full bg-brand-50 px-3 py-1 text-sm text-brand-700 dark:bg-slate-800 dark:text-brand-400">{s}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </Section>
    )}

    {d.projects.length > 0 && (
      <Section id="projects" title={d.ui.nav.projects}>
        <div class="grid gap-6 sm:grid-cols-2">
          {d.projects.map((pj) => (
            <article class={`${card} flex flex-col overflow-hidden p-0`}>
              {pj.image ? (
                <img src={asset(pj.image)} alt={pj.name} loading="lazy" class="aspect-video w-full object-cover" />
              ) : (
                <div class="flex aspect-video w-full items-center justify-center bg-gradient-to-br from-brand-100 to-brand-50 text-3xl font-bold text-brand-600 dark:from-slate-800 dark:to-slate-900 dark:text-brand-400">
                  {pj.name}
                </div>
              )}
              <div class="flex flex-1 flex-col p-5">
                <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{pj.name}</h3>
                <p class="mt-2 flex-1 text-slate-600 dark:text-slate-300">{pj.description}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {pj.tech.map((t) => (
                    <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">{t}</span>
                  ))}
                </div>
                {(pj.code || pj.demo) && (
                  <div class="no-print mt-4 flex gap-4 text-sm font-semibold">
                    {pj.code && <a href={pj.code} target="_blank" rel="noopener" class="text-brand-600 hover:underline dark:text-brand-400">{d.ui.viewCode} ↗</a>}
                    {pj.demo && <a href={pj.demo} target="_blank" rel="noopener" class="text-brand-600 hover:underline dark:text-brand-400">{d.ui.viewDemo} ↗</a>}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </Section>
    )}

    {d.certificates.length > 0 && (
      <Section id="certificates" title={d.ui.nav.certificates}>
        <ul class="grid gap-3 md:grid-cols-2">
          {d.certificates.map((ct) => (
            <li class={`${card} flex items-center justify-between gap-4`}>
              <div>
                <p class="font-semibold text-slate-900 dark:text-white">{ct.name}</p>
                <p class="text-sm text-slate-500 dark:text-slate-400">{ct.issuer}</p>
              </div>
              <span class="text-sm text-slate-500 dark:text-slate-400">{ct.year}</span>
            </li>
          ))}
        </ul>
      </Section>
    )}

    <Section id="contact" title={d.ui.nav.contact}>
      <p class="mb-6 max-w-2xl text-slate-600 dark:text-slate-300">{d.ui.contactIntro}</p>
      <div class="grid gap-3 sm:grid-cols-2">
        {contacts.map((x) => (
          <a href={x.href} target={x.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class={`${card} flex items-center gap-4 transition hover:border-brand-400`}>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600 dark:bg-slate-800 dark:text-brand-400">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={x.icon} /></svg>
            </span>
            <span class="min-w-0">
              <span class="block text-sm text-slate-500 dark:text-slate-400">{x.label}</span>
              <span class="block truncate font-medium text-slate-900 dark:text-white">{x.value}</span>
            </span>
          </a>
        ))}
      </div>
    </Section>
  </main>

  <footer class="no-print border-t border-slate-200 py-8 text-center text-sm text-slate-500 dark:border-slate-800 dark:text-slate-400">
    © {new Date().getFullYear()} {d.profile.name} · {d.ui.footer}
  </footer>
</Base>
