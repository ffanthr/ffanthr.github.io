---
import type { Lang } from '../utils';
import { data, asset, initials } from '../utils';

interface Props { lang: Lang }
const d = data[Astro.props.lang];
const p = d.profile;
---
<section id="top" class="bg-gradient-to-b from-brand-50 to-white dark:from-slate-900 dark:to-slate-950">
  <div class="mx-auto flex max-w-5xl flex-col-reverse items-center gap-10 px-4 py-16 sm:px-6 md:flex-row md:py-24">
    <div class="flex-1 text-center md:text-left">
      <p class="mb-2 font-medium text-brand-600 dark:text-brand-400">{p.title}</p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-white">{p.name}</h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">{p.summary}</p>
      {p.location && (
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">📍 {p.location}</p>
      )}
      <div class="no-print mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
        {p.resumePdf && (
          <a href={asset(p.resumePdf)} download class="rounded-lg bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-brand-700">
            ⬇ {d.ui.downloadResume}
          </a>
        )}
        <a href="#contact" class="rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-800 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800">
          {d.ui.contactMe}
        </a>
      </div>
    </div>
    <div class="shrink-0">
      {p.photo ? (
        <img src={asset(p.photo)} alt={p.name} width="224" height="224" class="h-44 w-44 rounded-full object-cover shadow-xl ring-4 ring-white sm:h-56 sm:w-56 dark:ring-slate-800" />
      ) : (
        <div class="flex h-44 w-44 items-center justify-center rounded-full bg-brand-500 text-5xl font-bold text-white shadow-xl ring-4 ring-white sm:h-56 sm:w-56 dark:ring-slate-800">
          {initials(p.name)}
        </div>
      )}
    </div>
  </div>
</section>
