---
interface Props { id: string; title: string }
const { id, title } = Astro.props;
---
<section id={id} class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
  <h2 class="mb-8 flex items-center gap-3 text-2xl font-bold text-slate-900 dark:text-white">
    <span class="h-6 w-1.5 rounded-full bg-brand-500"></span>
    {title}
  </h2>
  <slot />
</section>
